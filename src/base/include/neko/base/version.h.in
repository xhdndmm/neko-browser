#pragma once

// Generated by CMake from include/neko/base/version.h.in.
// Do not edit by hand; change the version in the root CMakeLists.txt instead.

#define NEKO_VERSION_MAJOR @PROJECT_VERSION_MAJOR @
#define NEKO_VERSION_MINOR @PROJECT_VERSION_MINOR @
#define NEKO_VERSION_PATCH @PROJECT_VERSION_PATCH @
#define NEKO_VERSION_STRING "@PROJECT_VERSION@"
#define NEKO_PROJECT_NAME "@PROJECT_NAME@"

#include <string_view>

namespace neko::base {

// Full version string, e.g. "0.1.0".
std::string_view GetVersionString();

// Major.minor.patch triple (currently identical to the version string).
std::string_view GetVersionTriple();

// Project display name, e.g. "neko-browser".
std::string_view GetProjectName();

// The User-Agent string sent on network requests and exposed to scripts via
// navigator.userAgent.  It follows the conventional browser UA format that
// web servers use to decide what content to serve: a bare "neko-browser/0.1.0"
// UA makes many sites (e.g. Baidu) treat the engine as a bot and respond with
// a reduced or script-redirect page.  The trailing NekoBrowser token keeps
// requests identifiable.
std::string_view GetUserAgent();

} // namespace neko::base
